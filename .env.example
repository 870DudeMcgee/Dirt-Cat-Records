# Site
SITE_URL=https://dirtcatrecords.com
ADMIN_EMAIL=
ALLOW_LOCAL_ADMIN_BYPASS=0

# PayPal checkout and webhooks
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Supabase database and auth
SUPABASE_URL=https://ossprdfycpdvewpxtsfw.supabase.co
SUPABASE_PUBLIC_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backward-compatible alias used by some older helpers. Prefer SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Google Drive automation
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Copy only the raw folder id from a URL like
# https://drive.google.com/drive/folders/<RAW_ID>?usp=sharing
# Do not paste the full drive.google.com URL here.
GOOGLE_DRIVE_PROJECTS_FOLDER_ID=
# Optional for preview/sandbox verification only: share upload folders with a
# real Google account when the PayPal sandbox buyer email cannot accept Google
# Drive sharing.
GOOGLE_DRIVE_TEST_SHARE_EMAIL=
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/drive

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Optional sandbox/test-run settings
TEST_BUSINESS_NAME=Dirt Cat Records
TEST_CUSTOMER_EMAIL=
TEST_EMAIL_RECIPIENT=
TEST_SUBJECT_PREFIX=[TEST]
TEST_DRIVE_FOLDER_PREFIX=TEST
